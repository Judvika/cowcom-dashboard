{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/universe/",
      "destination": "https://cowcom-universe.vercel.app/universe"
    },
    {
      "source": "/universe",
      "destination": "https://cowcom-universe.vercel.app/universe"
    },
    {
      "source": "/universe/:path*",
      "destination": "https://cowcom-universe.vercel.app/universe/:path*"
    }
  ]
}
